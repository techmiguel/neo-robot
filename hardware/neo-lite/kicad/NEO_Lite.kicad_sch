	(text "VBUS: entrada del conector (antes de F1).\n+5V: después de F1; alimenta U1 y el amplificador U4.\nR1/R2 de 5,1 kΩ: sin ellas un cargador USB-C no entrega 5 V.\nU1 TLV1117LV33 (no AMS1117): ver docs/fase1-componentes.md §2.3." (exclude_from_sim no) (at 119.38 95.25 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "78650111-cfb9-504b-8763-7e67ccc557b0"))
