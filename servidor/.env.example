# ── Modo del servidor WebSocket ─────────────────────────────────────────────
# echo: devuelve el audio recibido (pruebas de conectividad)
# pipeline: STT + LLM + TTS completo
WS_MODO=pipeline
WS_PORT=8765

# ── STT ──────────────────────────────────────────────────────────────────────
# groq | local
STT_PROVIDER=groq

# ── LLM ──────────────────────────────────────────────────────────────────────
# groq | ollama
LLM_PROVIDER=groq

# ── Groq (STT + LLM en nube, gratis con límites) ─────────────────────────────
# Clave gratuita en https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_LLM_MODEL=openai/gpt-oss-20b
# Solo modelos gpt-oss: razonamiento corto para que no agote los tokens pensando
GROQ_REASONING_EFFORT=low

# ── Personalidad (system prompt) ─────────────────────────────────────────────
# corto (~140 tokens, por defecto con Ollama) | completo (con ejemplos, por defecto con Groq).
# En CPU local el completo cuesta ~8 s más de primer token (ver docs/metrics/validacion_gemma4_streaming).
# NEO_PROMPT=corto
# O un prompt propio, que manda sobre los dos:
# NEO_SYSTEM_PROMPT=Eres NEO, ...

# ── Ollama (LLM local, sin internet) ─────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
# Alternativa de 1,0 GB por medir: LFM3-1.7B de Liquid AI (scripts/windows/descargar_lfm3.bat)
# OLLAMA_MODEL=lfm3:1.7b-qad-q4_0
# Razonamiento ("thinking"): false lo desactiva. gemma4/qwen3 pueden pensar
# cientos de tokens antes de responder = segundos de silencio en CPU.
# Vacío = no enviar el campo (modelos sin soporte de razonamiento).
OLLAMA_THINK=false
# Tope de tokens de salida (NEO responde una oración corta)
OLLAMA_NUM_PREDICT=96
# Ventana de contexto: más pequeña = menos RAM y prompt más rápido
OLLAMA_NUM_CTX=2048
# Cuánto se queda cargado el modelo sin uso. -1m = siempre (con unidad: Ollama
# rechaza "-1" a secas). Recargarlo desde disco tarda segundos o minutos.
OLLAMA_KEEP_ALIVE=60m
# Muestreo: sin definir se usa el del Modelfile (gemma4: el recomendado por Google)
# OLLAMA_TEMPERATURE=0.7

# ── Faster-Whisper (STT local) ───────────────────────────────────────────────
WHISPER_MODEL_SIZE=base

# ── TTS ──────────────────────────────────────────────────────────────────────
# edge (Microsoft, requiere internet) | local (Piper, offline)
TTS_PROVIDER=edge
# Voz Piper: https://huggingface.co/rhasspy/piper-voices (.onnx + .onnx.json juntos)
PIPER_MODEL=ruta/a/es_MX-ald-medium.onnx

# ── Respuesta en streaming ───────────────────────────────────────────────────
# La respuesta se sintetiza por fragmentos mientras el LLM genera.
# 0 = modo anterior (respuesta completa, un solo TTS), para comparar.
RESPUESTA_STREAMING=1
# El primer fragmento se corta en coma si ya tiene al menos N palabras
# (menos = primer audio antes, pero más cortes de entonación).
TTS_MIN_PALABRAS_COMA=5
# Corte de seguridad si el LLM no pone puntuación
TTS_MAX_PALABRAS=30

# ── Phase 5: handlers de comandos ────────────────────────────────────────────

# OpenWeatherMap — https://openweathermap.org/api (plan gratuito disponible)
OPENWEATHER_API_KEY=
CLIMA_CIUDAD_DEFAULT=La Habana

# NewsAPI — https://newsapi.org (plan gratuito disponible)
NEWSAPI_KEY=
NOTICIAS_PAIS_DEFAULT=mx

# CoinGecko no requiere API key para uso básico

# El Toque — https://tasas.eltoque.com/docs (JWT de larga duración)
# Endpoint: GET /v1/trmi  Authorization: Bearer <token>
ELTOQUE_API_KEY=
